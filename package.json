{
  "name": "selskaya-pochta",
  "private": true,
  "version": "1.0.0",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "electron:start": "electron electron/main.cjs",
    "electron:test": "npm run build && electron electron/main.cjs",
    "electron:package": "npm run build && npx @electron/packager . PostalDriver --platform=win32 --arch=x64 --out=build-electron --overwrite --prune=false --ignore=\"(\\..*|node_modules|src|asset-library|music|docs|reports|temp_.*)\"",
    "deploy": "npm run build && node scripts/deploy-to-s3.cjs",
    "voice:script": "node scripts/voice-script.mjs",
    "playtest": "node scripts/playtest/cdp.mjs scripts/playtest/autopilot.js"
  },
  "dependencies": {
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@types/three": "^0.170.0",
    "electron": "^41.7.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
